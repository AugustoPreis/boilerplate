# pnpm auto-runs a dependency-status check before every command and, if
# node_modules drifts from the lockfile (e.g. after adding a dependency on
# the host while a container's anonymous volume still has the old
# node_modules), tries to reinstall on its own. Without this, that
# self-repair asks for an interactive confirmation to purge node_modules
# first — which aborts in any non-TTY context (Docker containers, CI).
confirm-modules-purge=false
