# Only necessary file to `docker compose up` work.
# Copy to `.env` at the root of the project before bringing up the containers.

# Application
APP_NAME=Boilerplate
NODE_ENV=development
PORT=3000
API_HOST_PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Database
DB_HOST=postgres
DB_PORT=5432
DB_HOST_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_password_change_me
DB_NAME=boilerplate
DB_SCHEMA=public
DB_LOGGING=false
DB_SSL=false
DB_POOL_SIZE=10

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh-change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
COOKIE_SECURE=false # true in production, false during development.

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=redis_password_change_me
REDIS_DB=0

# Admin seed
ADMIN_EMAIL=admin@boilerplate.local
ADMIN_PASSWORD=change-me-in-production

# Frontend
VITE_API_BASE_URL=http://localhost:3000
VITE_API_VERSION=v1
VITE_APP_NAME=Boilerplate
