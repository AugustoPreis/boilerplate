# Only necessary file to `docker compose up` work.
# Copy to `.env` at the root of the project before bringing up the containers.

# Application
APP_NAME=Boilerplate
NODE_ENV=development
PORT=3000
API_HOST_PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database
DB_HOST=postgres
DB_PORT=5432
DB_HOST_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_password_change_me
DB_NAME=boilerplate
DB_SCHEMA=public
DB_LOGGING=false
DB_SSL=false
DB_POOL_SIZE=10

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh-change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_SECRET=password-reset-change-me-in-production
PASSWORD_RESET_EXPIRES_IN=30m
BCRYPT_ROUNDS=12
COOKIE_SECURE=false # true in production, false during development.

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=redis_password_change_me
REDIS_DB=0

# Mail (points at the local MailHog container in dev, see docker-compose.override.yml;
# swap for a real SMTP provider in production)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@boilerplate.local

# Storage (S3-compatible, MinIO in dev)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=boilerplate
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_change_me
S3_FORCE_PATH_STYLE=true
S3_AUTO_CONFIGURE_BUCKET=true # dev only, see apps/api/docs/storage.md

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me

# Admin seed
ADMIN_EMAIL=admin@boilerplate.local
ADMIN_PASSWORD=change-me-in-production

# Frontend
WEB_HOST_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
VITE_API_VERSION=v1
VITE_APP_NAME=Boilerplate
