# Único arquivo de configuração necessário para `docker compose up` funcionar.
# Copie para `.env` na raiz do projeto antes de subir os containers.

# Application
APP_NAME=Boilerplate
NODE_ENV=development
# PORT: porta em que a API escuta DENTRO do container — nunca mude para
# resolver conflito de porta no host, use API_HOST_PORT para isso.
PORT=3000
API_HOST_PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Database (DB_HOST=postgres é o nome do serviço no docker-compose, não um host real)
# DB_PORT é a porta interna da rede Docker (sempre 5432) — se a porta padrão
# do seu host já estiver em uso por outro Postgres, mude só DB_HOST_PORT.
DB_HOST=postgres
DB_PORT=5432
DB_HOST_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_password_change_me
DB_NAME=boilerplate
DB_SCHEMA=public
DB_LOGGING=false
DB_SSL=false
DB_POOL_SIZE=10

# Auth (JWT via cookies httpOnly — nunca expostos ao JavaScript do browser)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh-change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# false em dev (Docker local sem TLS); DEVE ser true em qualquer ambiente real
# (cookie Secure exige HTTPS) — a validação de config força isso em produção.
COOKIE_SECURE=false

# Redis (cache, rate-limit) — REDIS_HOST=redis é o nome do serviço no docker-compose
# REDIS_PORT é a porta interna da rede Docker (sempre 6379) — use
# REDIS_HOST_PORT se a porta padrão do host já estiver ocupada.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=redis_password_change_me
REDIS_DB=0

# Admin semeado (Fase 3)
ADMIN_EMAIL=admin@boilerplate.local
ADMIN_PASSWORD=change-me-in-production

# Frontend
VITE_API_BASE_URL=http://localhost:3000
VITE_API_VERSION=v1
VITE_APP_NAME=Boilerplate
