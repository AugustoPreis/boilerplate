# Application
APP_NAME=Boilerplate
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=boilerplate
DB_SCHEMA=public
DB_LOGGING=false
DB_SSL=false
DB_POOL_SIZE=10

# Redis (cache, rate-limit)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth (JWT via cookies httpOnly — nunca expostos ao JavaScript do browser)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh-change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# false em dev (Docker local sem TLS); DEVE ser true em qualquer ambiente real
# (cookie Secure exige HTTPS) — a validação de config força isso em produção.
COOKIE_SECURE=false

# Admin semeado (Fase 3)
ADMIN_EMAIL=admin@boilerplate.local
ADMIN_PASSWORD=change-me-in-production
